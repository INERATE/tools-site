{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "tools-site",
  "account_id": "09fc9d2f5f1796915f66c4cd4302d111",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI. A binding, not an API token — the credential never exists in
  // the browser, so the free daily allowance cannot be drained by anyone who
  // opens devtools. Nothing to configure in the dashboard.
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "tools.inerate.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

